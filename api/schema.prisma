// This file stores the relevant schema and models for the Prisma connection to the MySQL database

datasource db {
  url      = env("DATABASE_URL")
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

// Account model
model Account {
  id       Int     @id @unique @default(autoincrement()) @map("account_id")
  username String  @unique
  email    String  @unique
  password String
  habits   Habit[]

  @@map("accounts")
}

// Habits model
model Habit {
  id            Int     @id @unique @default(autoincrement()) @map("habit_id")
  description   String
  type          String
  difficulty    Int
  points        Int
  targetNumber  Int
  currentNumber Int
  isDone        Int
  accountId     Int     @map("account_id")
  account       Account @relation(fields: [accountId], references: [id])

  @@map("habits")
}
